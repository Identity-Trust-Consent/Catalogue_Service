# Server-only Java consent service; Catalogue forwards the signed-in user's token.
CONSENT_SERVICE_URL=http://localhost:8088

# Published registration notice template served by the Java consent service.
CONSENT_NOTICE_TEMPLATE_CODE=2X67hx8xHO

